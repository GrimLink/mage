# --- commands/set/csp.sh
MAGE_SET_HANDLERS+=("csp|Enforce a strict CSP on the storefront, no inline or eval scripts")

# Locked in app/etc/env.php, as a strict CSP is a choice of the codebase,
# such as a Hyva CSP theme, not a setting to change in the admin
function mage_set_csp() {
  $MAGENTO_CLI config:set --lock-env csp/mode/storefront/report_only 0 &&
    $MAGENTO_CLI config:set --lock-env csp/policies/storefront/scripts/inline 0 &&
    $MAGENTO_CLI config:set --lock-env csp/policies/storefront/scripts/eval 0 || exit 1

  $MAGENTO_CLI cache:clean config
}
# --- commands/set/fpc.sh
MAGE_SET_HANDLERS+=("fpc|Use the builtin full page cache, or with 'varnish' Varnish")

function mage_set_fpc() {
  local application

  case "${1:-builtin}" in
    "builtin" | "default") application=1 ;;
    "varnish") application=2 ;;
    *)
      mage_error "Unknown full page cache '$1', use builtin (or default) or varnish"
      exit 1
      ;;
  esac

  $MAGENTO_CLI config:set system/full_page_cache/caching_application "$application"
}

# Commands that run outside a Magento project, setup finds the root itself
MAGE_ROOTLESS_COMMANDS="help version self-update create setup"

# Run the given command, where anything unknown goes to bin/magento
function mage_main() {
  if [[ " $MAGE_ROOTLESS_COMMANDS " != *" $1 "* ]]; then
    mage_root_enter || exit 1
    mage_env_init
  fi

  case "$1" in
    "help")
      mage_cmd_version
      mage_cmd_help
      ;;
    "version")
      mage_cmd_version
      ;;
    "self-update")
      mage_cmd_self_update
      ;;
    "create")
      mage_cmd_create "${@:2}"
      ;;
    "setup")
      mage_cmd_setup "${@:2}"
      ;;
    "nuke" | "destroy")
      mage_cmd_nuke "${@:2}"
      ;;
    "backup")
      mage_cmd_backup "${@:2}"
      ;;
    "restore")
      mage_cmd_restore "${@:2}"
      ;;
    "sync")
      mage_cmd_sync "${@:2}"
      ;;
    "add")
      mage_cmd_add "${@:2}"
      ;;
    "del" | "remove")
      mage_cmd_remove "${@:2}"
      ;;
    "upd" | "update")
      mage_cmd_update "${@:2}"
      ;;
    "enable" | "disable")
      mage_cmd_module "$@"
      ;;
    "outdated")
      mage_cmd_outdated "${@:2}"
      ;;
    "set")
      mage_cmd_set "${@:2}"
      ;;
    "show")
      mage_cmd_show "${@:2}"
      ;;
    "info")
      mage_cmd_info "${@:2}"
      ;;
    "open")
      mage_cmd_open "${@:2}"
      ;;
    "watch")
      mage_cmd_watch
      ;;
    "build")
      mage_cmd_build "${@:2}"
      ;;
    "reindex")
      mage_cmd_reindex
      ;;
    "log")
      mage_cmd_log "${@:2}"
      ;;
    "run")
      mage_cmd_run "${@:2}"
      ;;
    "clean" | "purge")
      mage_cmd_clean "${@:2}"
      ;;
    *)
      $MAGENTO_CLI "$@"
      ;;
  esac
}

# Only run when executed, so the tests can source this file
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  mage_main "$@"
fi
