  if [[ ! "$MAGE_NEW_VENDOR" =~ ^[A-Za-z][A-Za-z0-9]*$ ]] || [[ ! "$MAGE_NEW_NAME" =~ ^[A-Za-z][A-Za-z0-9]*$ ]]; then
